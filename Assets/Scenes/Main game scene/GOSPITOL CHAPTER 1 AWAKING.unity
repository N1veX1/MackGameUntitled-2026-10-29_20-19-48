--- !u!114 &805635518
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 805635516}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a54d0cfe04b55040b566564e6b4bb7b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HospitalInteractable
  action: 0
  title: "\u041C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u044C / \u043F\u0440\u0438\u0447\u0438\u043D\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F"
  body: "\u041F\u0440\u0438\u0447\u0438\u043D\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F: \u0442\u0440\u0430\u0432\u043C\u0430, \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u0430\u044F \u0432 \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u043C \u0441\u0435\u043A\u0442\u043E\u0440\u0435.\n\n\u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435: \u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043E.\n\n\u041D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435: \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u0435 \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u044F \u0430\u0432\u0442\u043E\u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043F\u0430\u043C\u044F\u0442\u0438. \u0420\u0435\u0447\u044C \u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043D\u0430\u0432\u044B\u043A\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B.\n\n\u041D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435: \u043F\u0435\u0440\u0432\u0438\u0447\u043D\u0430\u044F \u043E\u0446\u0435\u043D\u043A\u0430, \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u044B\u0439 \u0432\u0432\u043E\u0434\u043D\u044B\u0439 \u043A\u0443\u0440\u0441.\n\n\u0412\u0438\u0434\u0435\u043E\u0437\u0430\u043F\u0438\u0441\u044C \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u0430 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0430 \u0432 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0439 \u0430\u0440\u0445\u0438\u0432 \u043F\u043E \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u044E \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0449\u0435\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B."
