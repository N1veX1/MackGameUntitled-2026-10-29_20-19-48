--- !u!114 &1786290382
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1786290380}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a54d0cfe04b55040b566564e6b4bb7b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HospitalInteractable
  action: 0
  title: "\u0416\u0443\u0440\u043D\u0430\u043B \xAB\u0412\u043D\u0443\u0442\u0440\u0438 \u043F\u0435\u0440\u0438\u043C\u0435\u0442\u0440\u0430\xBB"
  body: "\u041D\u041E\u0412\u042B\u0419 \u041F\u0410\u0420\u041A \xAB\u0421\u041E\u041B\u041D\u0415\u0427\u041D\u042B\u0419 \u041A\u0420\u0423\u0413\xBB \u041E\u0422\u041A\u0420\u042B\u0412\u0410\u0415\u0422\u0421\u042F \u0412 \u0421\u0423\u0411\u0411\u041E\u0422\u0423\n\n\u0412\u043F\u0435\u0440\u0432\u044B\u0435 \u043F\u043E\u0441\u043B\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E \u0436\u0438\u043B\u043E\u0433\u043E \u043A\u043E\u043B\u044C\u0446\u0430 \u0433\u043E\u0440\u043E\u0436\u0430\u043D\u0430\u043C \u0441\u0442\u0430\u043D\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043F\u0440\u043E\u0433\u0443\u043B\u043E\u0447\u043D\u0430\u044F \u0437\u043E\u043D\u0430 \u0441 \u0436\u0438\u0432\u044B\u043C\u0438 \u0434\u0435\u0440\u0435\u0432\u044C\u044F\u043C\u0438.\n\n\u0414\u043B\u044F \u0434\u0435\u0442\u0435\u0439 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u044B \u0438\u0433\u0440\u043E\u0432\u044B\u0435 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0438, \u0434\u043B\u044F \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0445 \u2014 \u0442\u0438\u0445\u0438\u0435 \u0434\u043E\u0440\u043E\u0436\u043A\u0438 \u0438 \u043A\u0440\u044B\u0442\u0430\u044F \u043E\u0440\u0430\u043D\u0436\u0435\u0440\u0435\u044F. \u0412 \u0434\u0435\u043D\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u043E\u0440\u043A\u0435\u0441\u0442\u0440 \u0432\u044B\u0441\u0442\u0443\u043F\u0438\u0442 \u0443 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0444\u043E\u043D\u0442\u0430\u043D\u0430.\n\n\u0412\u0445\u043E\u0434 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0439. \u041F\u0440\u043E\u0441\u0438\u043C \u0437\u0430\u0440\u0430\u043D\u0435\u0435 \u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0432\u0440\u0435\u043C\u044F \u043F\u043E\u0441\u0435\u0449\u0435\u043D\u0438\u044F \u043E\u0440\u0430\u043D\u0436\u0435\u0440\u0435\u0438.\n\n\u041F\u0435\u0440\u0432\u044B\u0435 \u0441\u0430\u0436\u0435\u043D\u0446\u044B \u0434\u043B\u044F \u043F\u0430\u0440\u043A\u0430 \u0436\u0438\u0442\u0435\u043B\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u043B\u0438 \u0434\u043E\u043C\u0430 \u0431\u043E\u043B\u044C\u0448\u0435 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u0438 \u043B\u0435\u0442."
  glassPanels: []
  clearGlass: {fileID: 0}
  privacyGlass: {fileID: 0}
  doorLeaf: {fileID: 0}
  privacyEnabled: 0
